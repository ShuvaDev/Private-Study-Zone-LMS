@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary: #6366f1;
            --secondary: #64748b;
            --border: #e2e8f0;
            --background: #f8fafc;
        }

        /* Progress Stepper */
        .stepper-wrapper {
            display: flex;
            justify-content: space-between;
            margin-top: 50px;
            margin-bottom: 20px;
        }

        .stepper-item {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            flex: 1;
        }

            .stepper-item::before,
            .stepper-item::after {
                position: absolute;
                content: "";
                border-bottom: 2px solid var(--border);
                width: 100%;
                top: 20px;
                z-index: 0;
            }

            .stepper-item .step-counter {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                background: #e2e8f0;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 8px;
                z-index: 1;
                transition: all 0.3s ease;
            }

            .stepper-item.active .step-counter {
                background: var(--primary);
                color: white;
            }

            .stepper-item.completed .step-counter {
                background: var(--primary);
                color: white;
            }

        /* Form Styles */
        .form-step {
            display: none;
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.3s ease;
        }

            .form-step.active {
                display: block;
                opacity: 1;
                transform: translateY(0);
            }



        /* Updated delete button styles */
        .delete-btn {
            position: absolute;
            top: 15px;
            right: 15px;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #ef4444;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            z-index: 2;
            border: none;
        }

            .delete-btn:hover {
                transform: scale(1.1);
                background: #dc2626;
            }

        .lesson-card {
            position: relative;
            background: var(--background);
            border: 2px dashed var(--border);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            padding-top: 2.5rem; /* Added space for delete button */
        }

        .video-item {
            position: relative;
            margin-bottom: 1rem;
            padding-right: 40px; /* Space for delete button */
        }

        .video-delete-btn {
            top: 50%;
            transform: translateY(-50%);
            right: 6px;
            background: black;
        }

    </style>
    }

    <div class="card">
        <!-- Progress Stepper -->
        <div class="stepper-wrapper">
            <div class="stepper-item active">
                <div class="step-counter">1</div>
                <div class="step-title">Basic Info</div>
            </div>
            <div class="stepper-item">
                <div class="step-counter">2</div>
                <div class="step-title">Details</div>
            </div>
            <div class="stepper-item">
                <div class="step-counter">3</div>
                <div class="step-title">Content</div>
            </div>
            <div class="stepper-item">
                <div class="step-counter">4</div>
                <div class="step-title">Review</div>
            </div>
        </div>

        <form id="courseForm" class="bg-white p-4 rounded-3 shadow-sm">
            <!-- Step 3: Course Content -->
            <div class="form-step active" id="step3">
                <h4 class="mb-4 text-primary"><i class="fas fa-play-circle me-2"></i>Course Content</h4>

                <div class="lessons-container">
                    <!-- Initial Lesson Card -->
                    <div class="lesson-card">
                        <div class="delete-btn lesson-delete-btn">
                            <i class="fas fa-times"></i>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Lesson Title</label>
                            <input type="text" class="form-control" required>
                        </div>

                        <div class="videos-container">
                            <div class="video-item">
                                <div class="delete-btn video-delete-btn">
                                    <i class="fas fa-times"></i>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Video Link</label>
                                    <input type="url" class="form-control" placeholder="https://example.com/video" required>
                                </div>
                            </div>
                        </div>

                        <button type="button" class="btn btn-outline-secondary btn-sm add-video">
                            <i class="fas fa-plus me-2"></i>Add Video
                        </button>
                    </div>
                </div>

                <button type="button" class="btn btn-outline-primary w-100 mt-3 add-lesson">
                    <i class="fas fa-plus me-2"></i>Add New Lesson
                </button>

                <div class="d-flex justify-content-between mt-4">
                    <button type="button" class="btn btn-outline-secondary prev-step">
                        <i class="fas fa-arrow-left me-2"></i>Back
                    </button>
                    <button type="button" class="btn btn-primary next-step">
                        Next <i class="fas fa-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>
        </form>
    </div>

@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            let currentStep = 3; // Start at content step for demo

            // Navigation functions
            function updateStepper() {
                $('.stepper-item').removeClass('active completed');
                $('.stepper-item').each(function(index) {
                    if ((index + 1) < currentStep) {
                        $(this).addClass('completed');
                    } else if ((index + 1) === currentStep) {
                        $(this).addClass('active');
                    }
                });
            }

            // Add New Lesson
            $('.add-lesson').click(function() {
                const newLesson = `
                    <div class="lesson-card">
                        <div class="delete-btn lesson-delete-btn">
                            <i class="fas fa-times"></i>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Lesson Title</label>
                            <input type="text" class="form-control" required>
                        </div>
                        <div class="videos-container">
                            <div class="video-item">
                                <div class="delete-btn video-delete-btn">
                                    <i class="fas fa-times"></i>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Video Link</label>
                                    <input type="url" class="form-control" placeholder="https://example.com/video" required>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm add-video">
                            <i class="fas fa-plus me-2"></i>Add Video
                        </button>
                    </div>`;
                $('.lessons-container').append(newLesson);
            });

            // Add Video
            $(document).on('click', '.add-video', function() {
                const videoContainer = $(this).siblings('.videos-container');
                const newVideo = `
                    <div class="video-item">
                        <div class="delete-btn video-delete-btn">
                            <i class="fas fa-times"></i>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Video Link</label>
                            <input type="url" class="form-control" placeholder="https://example.com/video" required>
                        </div>
                    </div>`;
                videoContainer.append(newVideo);
            });

            // Delete Lesson
            $(document).on('click', '.lesson-delete-btn', function() {
                if($('.lesson-card').length > 1) {
                    $(this).closest('.lesson-card').remove();
                } else {
                    alert('You must have at least one lesson!');
                }
            });

            // Delete Video
            $(document).on('click', '.video-delete-btn', function() {
                const videoContainer = $(this).closest('.videos-container');
                if(videoContainer.children().length > 1) {
                    $(this).closest('.video-item').remove();
                } else {
                    alert('Each lesson must have at least one video!');
                }
            });

            // Step Navigation
            $('.next-step').click(function() {
                if(currentStep < 4) {
                    $(`#step${currentStep}`).removeClass('active');
                    currentStep++;
                    $(`#step${currentStep}`).addClass('active');
                    updateStepper();
                }
            });

            $('.prev-step').click(function() {
                if(currentStep > 1) {
                    $(`#step${currentStep}`).removeClass('active');
                    currentStep--;
                    $(`#step${currentStep}`).addClass('active');
                    updateStepper();
                }
            });

            // Initialize stepper
            updateStepper();
        });
    </script>
}