        .carousel-inner {
                border-radius: 15px;
                border: 5px solid #ffa500;
        }
    </style>

    <link rel="stylesheet" href="~/css/slick.css">
    <link rel="stylesheet" href="~/css/slick.custom.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://db.onlinewebfonts.com/c/0a6ee448d1bd65c56f6cf256a7c6f20a?family=Bahnschrift" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.3.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/fontawesome.min.css" integrity="sha512-v8QQ0YQ3H4K6Ic3PJkym91KoeNT5S3PnDKvqnwqFD1oiqIl653crGZplPdU5KKtHjO0QKcQ2aUlQZYjHczkmGw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        .rating-section {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
        }

        .stars {
            color: #ffd700;
            margin-right: 8px;
        }

        .review-count {
            font-size: 0.85em;
            color: #666;
        }

        .course-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            padding: 10px 0;
            border-top: 1px solid #ecf0f1;
            border-bottom: 1px solid #ecf0f1;
        }

        .course-type {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .course-badge {
            background: #2d98da;
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8em;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .video-count {
            color: #7f8c8d;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 0.9em;
        }
    </style>

}

<div class="banner-wrapper">
    <div class="container">
        <div class="row banner" style="min-height: 450px;">
            <div class="col-12 col-md-7 col-lg-8 order-1 order-md-0 py-5">
                <h1 class="banner-title-1" style="font-family: 'Space Grotesk'; font-size: 40px;">
                    <span id="auto-type" style="font-family: 'Space Grotesk'; background: #ffe0e0; color: rgb(254, 102, 103); font-weight: bold; padding: 7px"></span> PREPARATION WITH PSZ
                </h1>
                <h1 class="banner-title-2 my-5" style="font-family:'Hind Siliguri'; font-size: 45px">ডুয়েট ভর্তিযুদ্ধে নিজেকে একধাপ এগিয়ে রাখতে প্রস্তুতি হোক সেরা শিক্ষকদের সাথে</h1>
