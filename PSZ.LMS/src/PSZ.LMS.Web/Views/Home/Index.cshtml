@{
    ViewData["Title"] = "PSZ";
}

@section Styles {
    <link rel="stylesheet" href="~/css/slick.css">
    <link rel="stylesheet" href="~/css/slick.custom.css">
    <link rel="stylesheet" href="~/css/home.index.css">
}

<div class="banner-wrapper">
    <div class="container">
        <div class="row banner pt-5" style="min-height: 450px;">
            <div class="col-12 col-md-7 col-lg-8 order-1 order-md-0 py-5">
                <h1 class="banner-title-1">
                    <span id="auto-type"></span> PREPARATION WITH PSZ
                </h1>
                <h1 class="banner-title-2 my-5">ডুয়েট ভর্তিযুদ্ধে নিজেকে একধাপ এগিয়ে রাখতে প্রস্তুতি হোক সেরা শিক্ষকদের সাথে</h1>
                <h3 class="banner-title-3 my-5 text-white bg-primary d-inline p-1">Academic কিংবা DUET ভর্তি পরীক্ষার সেরা Preparation নাও ঘরে বসেই</h3>
            </div>
            <div class="col-12 col-md-5 col-lg-4 d-flex justify-content-center order-0 py-5">
                <img src="~/images/Sahid-Minar.png" width="270px" height="340px"/>
            </div>
        </div>
        <a asp-controller="" asp-action="" class="btn btn-lg btn-dark mx-2" style="font-family: 'Hind Siliguri';">একাউন্ট খুলো  <i class="bi bi-person-circle"></i></a>
        <a asp-controller="" asp-action="" class="btn btn-lg btn-warning" style="font-family: 'Hind Siliguri';">কোর্সগুলো দেখো  <i class="bi bi-box-arrow-in-up-right"></i></a>
    </div>


    <!-- Social Card Section -->
    <div class="py-5">
        <div class="container">
            <div class="row g-3">
                <!-- Facebook Group -->
                <div class="col-12 col-lg-4">
                    <a href="" target="_blank" class="card-link" style="text-decoration: none;">
                        <div class="social-card bg-glass-blue">
                            <div class="card-icon">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <div class="card-content">
                                <h3>Community Hub</h3>
                                <p class="mb-2">Join 10k+ members in our Facebook group</p>
                                <div class="action-btn mt-2">
                                    <span>Explore Community</span>
                                    <i class="bi bi-arrow-up-right"></i>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- YouTube Channel -->
                <div class="col-12 col-lg-4">
                    <a href="https://www.youtube.com/@@PrivateStudyZone" target="_blank" class="card-link" style="text-decoration: none;">
                        <div class="social-card bg-glass-red">
                            <div class="card-icon">
                                <i class="bi bi-play-btn-fill"></i>
                            </div>
                            <div class="card-content">
                                <h3>Video Content</h3>
                                <p class="mb-2">Subscribe for weekly tutorials & guides</p>
                                <div class="action-btn mt-2">
                                    <span>Watch Videos</span>
                                    <i class="bi bi-arrow-up-right"></i>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>

                <!-- Facebook Page -->
                <div class="col-12 col-lg-4">
                    <a href="https://www.facebook.com/PrivateStudyZone" target="_blank" class="card-link" style="text-decoration: none;">
                        <div class="social-card bg-glass-blue">
                            <div class="card-icon">
                                <i class="bi bi-megaphone-fill"></i>
                            </div>
                            <div class="card-content">
                                <h3>Latest Updates</h3>
                                <p class="mb-2">Follow our official Facebook page</p>
                                <div class="action-btn mt-2">
                                    <span>Stay Updated</span>
                                    <i class="bi bi-arrow-up-right"></i>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

