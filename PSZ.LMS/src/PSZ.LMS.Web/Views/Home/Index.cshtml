@{
    ViewData["Title"] = "Home";
}


<div style ="background: #8707070a;">
    <div class="container">
        <div class="row banner" style="min-height: 480px;">
            <div class="col-12 col-md-7 col-lg-8 order-1 order-md-0 py-5">
                <h1 class="banner-title-1" style="font-family: 'Space Grotesk'; font-size: 40px;">
                    <span id="auto-type" style="font-family: 'Space Grotesk'; background: #ffe0e0; color: rgb(254, 102, 103); font-weight: bold; padding: 7px"></span> PREPARATION WITH PSZ
                </h1>
                <h1 class="banner-title-2 my-5" style="font-family:'Hind Siliguri'; font-size: 45px">ডুয়েট ভর্তিযুদ্ধে নিজেকে একধাপ এগিয়ে রাখতে প্রস্তুতি হোক সেরা শিক্ষকদের সাথে</h1>
                <h3 class="banner-title-3 my-5 text-white bg-primary d-inline p-1" style="font-family:'Li Ador Noirrit'; font-size: 24px">Academic কিংবা DUET ভর্তি পরীক্ষার সেরা Preparation নাও ঘরে বসেই</h3>
            </div>
            <div class="col-12 col-md-5 col-lg-4 d-flex justify-content-center order-0 py-5">
                <img src="~/images/Sahid-Minar.png" width="270px" height="340px"/>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/typed.js@2.1.0/dist/typed.umd.js"></script>
    <script>
        var typed = new Typed("#auto-type", {
            strings : ["DUET ADMISSION", "ACADEMIC"],
            typeSpeed : 150,
            backSpeed : 150,
            loop : true
        });
    </script>
}