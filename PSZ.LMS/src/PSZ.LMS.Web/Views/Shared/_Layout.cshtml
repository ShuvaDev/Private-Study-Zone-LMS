<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Private Study Zone</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PSZ.LMS.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <div class="container p-4 bg-white">
            

            <div class="row">
                <div class="col-6 col-md-4 col-xl-3 d-flex align-items-center brand p-0">
                    <img src="~/images/brand-logo.png" alt="Logo" class="brand-logo" height="70px" width="70px">
                    <span class="brand-text text-primary">Private Study Zone</span>
                </div>
                <div class="col-2 col-xl-3 d-none d-md-block mt-3 p-0">
                    <div class="dropdown">
                        <button class="btn btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" style="padding: 5px">
                            Categories
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Category 1</a></li>
                            <li><a class="dropdown-item" href="#">Category 2</a></li>
                            <li><a class="dropdown-item" href="#">Category 3</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-6 p-0">
                    <div class="search-container mt-3">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text" class="form-control" placeholder="Search for course content...">
                    </div>
                </div>
            </div>



        </div>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow" style="font-size:18px">
            <div class="container">
                <!-- Navbar Toggler (Left Side) -->
                <button class="navbar-toggler me-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>


                <!-- Navbar Content -->
                <div class="collapse navbar-collapse w-100" id="navbarNav">
                    <!-- Navigation Links (Left Side) -->
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Courses</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Contact</a>
                        </li>
                    </ul>

                    <!-- Login/Register (Always on Right) -->
                    <div class="ms-auto d-flex align-items-center">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>




    </header>
    <div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="edu-footer pt-5">
        <div class="container">
            <div class="row g-5">
                <!-- Brand Column -->
                <div class="col-lg-4">
                    <a href="#" class="edu-brand">Private Study Zone</a>
                    <p class="small">Your Gateway to Success in DUET & Polytechnic Admissions</p>
                    <div class="d-flex gap-3 mt-3">
                        <a href="#" class="footer-link">
                            <i class="fab fa-facebook fa-lg"></i>
                        </a>
                        <a href="#" class="footer-link">
                            <i class="fab fa-whatsapp fa-lg"></i>
                        </a>
                        <a href="#" class="footer-link">
                            <i class="fab fa-youtube fa-lg"></i>
                        </a>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="col-lg-2 col-6">
                    <h6 class="footer-heading">Courses</h6>
                    <div class="d-flex flex-column">
                        <a href="#" class="footer-link small mb-2">DUET Admission</a>
                        <a href="#" class="footer-link small mb-2">Polytechnic Courses</a>
                        <a href="#" class="footer-link small mb-2">Crash Courses</a>
                        <a href="#" class="footer-link small">Special Packages</a>
                    </div>
                </div>

                <!-- Resources -->
                <div class="col-lg-2 col-6">
                    <h6 class="footer-heading">Resources</h6>
                    <div class="d-flex flex-column">
                        <a href="#" class="footer-link small mb-2">Study Materials</a>
                        <a href="#" class="footer-link small mb-2">Sample Questions</a>
                        <a href="#" class="footer-link small mb-2">Previous Papers</a>
                        <a href="#" class="footer-link small">FAQs</a>
                    </div>
                </div>

                <!-- Contact Information -->
                <div class="col-lg-4">
                    <h6 class="footer-heading">Contact Us</h6>
                    <div class="contact-info small">
                        <p class="mb-3">
                            <i class="fas fa-map-marker-alt"></i>
                            Academic Tower, 12/B Road 7<br>
                            Dhaka 1212, Bangladesh
                        </p>
                        <p class="mb-3">
                            <i class="fas fa-phone"></i>
                            +880 1711-234567<br>
                            +880 1812-345678
                        </p>
                        <p class="mb-0">
                            <i class="fas fa-envelope"></i>
                            info@privatestudyzone.com
                        </p>
                    </div>
                </div>
            </div>

            <!-- Divider -->
            <hr class="my-5 border-gray-700">

            <!-- Bottom Row -->
            <div class="row py-3">
                <div class="col-md-6 text-center text-md-start">
                    <p class="small mb-0">© 2023 Private Study Zone. All rights reserved.</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <div class="d-flex gap-3 justify-content-md-end">
                        <a href="#" class="text-muted small text-decoration-none">Admission Policy</a>
                        <a href="#" class="text-muted small text-decoration-none">Terms of Service</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
